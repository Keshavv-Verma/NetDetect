# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables & secrets
.env
.env.*
!.env.example
!.env.template

# Streamlit runtime & credentials (keep config.toml)
.streamlit/*
!.streamlit/config.toml
.streamlit/secrets.toml

# Large packet capture dumps (keep sample)
*.pcap
*.pcapng
*.cap
!sample_pcaps/sample_traffic.pcap

# Temporary & scratch scripts
scratch/

# Raw dataset directories at root (prevent accidental commit of huge training CSVs)
/data/
/dataset/
/datasets/
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Preserve essential live simulation dataset
!live_ids/data/
!live_ids/data/KDDTest+.txt

# OS-generated files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
*.swp
*.swo
*~

# IDE & Editor files
.idea/
.vscode/*
!.vscode/settings.json

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Python packaging & testing caches
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Logs & runtime activity traces
*.log
*.jsonl
/logs/
live_ids/logs/*
!live_ids/logs/.gitkeep
